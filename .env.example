# The real production domain (no trailing slash). Every canonical URL,
# sitemap entry, and JSON-LD @id in src/lib/seo.ts is derived from this —
# it must be set before deploying, or SEO metadata will point at a placeholder.
NEXT_PUBLIC_SITE_URL=https://insyunik.am
# InSyunik-Api as the browser sees it. Local default: http://localhost:5080
NEXT_PUBLIC_API_URL=http://localhost:5080
# Optional: the API as the Next server sees it (an internal address). Falls back to NEXT_PUBLIC_API_URL.
# API_URL=
# Optional: storage host for listing photos served by the API (Supabase project URL); adds it to
# next.config.mjs's image allow-list. Not needed until property uploads exist.
# NEXT_PUBLIC_SUPABASE_URL=
